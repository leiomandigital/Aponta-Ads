# Client-side — seguros de expor no bundle (protegidos por RLS no Supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — usados em /api para Supabase Vault e sincronização.
# NUNCA prefixar com VITE_, NUNCA referenciar em código de src/.
SUPABASE_SERVICE_ROLE_KEY=

# Protege /api/sync/dispatch contra chamada automática não autorizada (Vercel Cron)
CRON_SECRET=
